# ─────────────────────────────────────────────────────────────
# Solar Design Tool (Streamlit) — server-side credentials.
# Read by database/supabase_client.py.
# ─────────────────────────────────────────────────────────────

# Base project URL — NO path suffix. supabase-py appends its own.
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-side only: bypasses RLS entirely. Never deploy this key to a
# Cerbo, to Node-RED, or to Apps Script — see the note below.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

ANTHROPIC_API_KEY=sk-ant-...
EXCHANGE_RATE_API_KEY=your-key-here

# ─────────────────────────────────────────────────────────────
# Victron Monitor deployment values — NOT used by this app for data access,
# and NOT interchangeable with the two keys above. Listed here only so
# nobody copies the wrong thing onto a Cerbo. See
# victron-monitor/docs/onboarding.md steps 2-3.
#
#   Node-RED env var   SUPABASE_URL      = <project URL>/rest/v1
#   Apps Script prop   SUPABASE_URL      = <project URL>/rest/v1
#                       ^ note the /rest/v1 suffix; the value above has none
#
#   Both also need     SUPABASE_ANON_KEY = the anon / public key
#                       (Supabase dashboard -> Project Settings -> API;
#                        newer projects show it as sb_publishable_...)
#
# SUPABASE_ANON_KEY (below, this file) is that SAME project anon key —
# there is only one per Supabase project — now ALSO consumed locally by the
# VRM Monitor customer portal's auth client (vrm_portal/auth.py:
# auth_client()), which uses it exclusively to prove who a customer/admin
# is (sign-in, password set/reset). It is never used for a .table()/
# .schema() call anywhere — see the two-client rule documented at the top
# of vrm_portal/auth.py. This app (Streamlit's app.py + pages/, including
# pages/06_vrm_monitor.py) still reads and writes exclusively through
# SUPABASE_SERVICE_ROLE_KEY above via database/supabase_client.py,
# completely unchanged by the portal's existence.
# ─────────────────────────────────────────────────────────────

SUPABASE_ANON_KEY=eyJ...

# ─────────────────────────────────────────────────────────────
# VRM Monitor customer portal (victron-monitor/portal/app.py) —
# read by vrm_portal/*. See PLAN_PHASE13.md.
# ─────────────────────────────────────────────────────────────

# Public base URL of the deployed portal (http://localhost:8501 while
# running locally). Used to build the activation link sent in invite/
# password-reset emails: {PORTAL_BASE_URL}/?token_hash=...&type=invite.
PORTAL_BASE_URL=http://localhost:8501

# Resend (email provider for invites/re-sends/password resets — and, once
# Phase 12 lands, weekly report delivery too). vrm_portal/mailer.py reads
# these; RESEND_API_KEY from https://resend.com/api-keys.
RESEND_API_KEY=re_...
PORTAL_FROM_EMAIL=reports@paulyco.com
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# vrm_api (the FastAPI pipeline service) — read by vrm_api/*.
# See PLAN_PHASE14.md §1.3/§2 Step 5, vrm_api/README.md.
# Reuses SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / ANTHROPIC_API_KEY above —
# this is the only NEW var this service needs.
# ─────────────────────────────────────────────────────────────

# Long random secret, held only here and in victron-monitor/web's server
# env. Every vrm_api route but GET /health requires
# `Authorization: Bearer <PIPELINE_API_KEY>` — see vrm_api/deps.py. Generate
# with e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
PIPELINE_API_KEY=...
# ─────────────────────────────────────────────────────────────
