# Template for the repo root's .env (Python side: Streamlit app, vrm_api,
# victron/, tools/). Copy to .env and fill in real values.
#
# The Next.js web app has its OWN env file — victron-monitor/web/.env.local —
# not covered here. Several values below are shared between the two (marked
# "(shared)"); see that file's header for the web-app-only vars.

# ── Supabase (shared project) ─────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Server-side only, bypasses RLS. Never put this on a Cerbo/Node-RED/Apps
# Script — those need SUPABASE_ANON_KEY below instead, with a /rest/v1
# suffix on the URL. Full deployment mapping: victron-monitor/docs/onboarding.md.
SUPABASE_ANON_KEY=eyJ...
# Also used by: Node-RED, Apps Script, and the legacy portal's auth client.

# ── AI / external APIs ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
EXCHANGE_RATE_API_KEY=your-key-here

# ── vrm_api (FastAPI pipeline service) ────────────────────────────────
PIPELINE_API_KEY=...
# (shared) Bearer secret every vrm_api route but /health requires — same
# value goes in web/.env.local's PIPELINE_API_KEY. Generate with
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
PUBLIC_TARIFF_API_KEY=...
# Separate secret, gates GET /public/tariffs/* only — NOT the same value as
# PIPELINE_API_KEY. Generate the same way.

# ── VRM Admin fleet access ─────────────────────────────────────────────
VRM_ADMIN_TOKEN=...
# Oscar's own Victron VRM personal access token (PLAN_PHASE15.md §3.3) —
# read access to every installation on his account. Never goes in
# web/.env.local or a browser.

# ── Resend (email) ─────────────────────────────────────────────────────
RESEND_API_KEY=re_...
PORTAL_FROM_EMAIL=reports@paulyco.com
# (shared) Same two values also go in web/.env.local.

# ── Scheduled report delivery ──────────────────────────────────────────
SITE_URL=http://localhost:3000
REPORT_UNSUBSCRIBE_SECRET=...
# (shared) Both values must also be set in web/.env.local — a random 32+
# byte hex string, e.g. `python3 -c "import secrets; print(secrets.token_hex(32))"`.

# ── ONVO Pay (billing) ──────────────────────────────────────────────────
ONVO_MODE=test
ONVO_SECRET_KEY=onvo_test_secret_key_...
ONVO_PUBLISHABLE_KEY=onvo_test_publishable_key_...
# Test-mode keys for everything except a real production deploy. Read only
# by vrm_api/onvo.py; never logged, never returned to a browser.
