# vrm_api — the FastAPI pipeline service (PLAN_PHASE14.md §1.4, §2 Step 5).
#
# Built and deployed as a Render Web Service (Standard, 2 GB, to start —
# §1.4). python:3.11-slim, not this repo's local 3.9: the 3.9 pin
# (CONTEXT.md §Environment) is a macOS accident, not a code requirement —
# every module already starts `from __future__ import annotations`. Step 5's
# validation proves the pipeline produces identical report numbers on 3.11
# before this image is trusted (vrm_api/README.md records the result).
#
# WeasyPrint (victron/weekly_report.py:render_pdf) needs Pango/Cairo/
# gdk-pixbuf as real system libraries — pip alone cannot install them, which
# is the reason this service needs a Dockerfile at all rather than a
# buildpack host (§1.4's hosting comparison table).
#
# Built from the REPO ROOT (`docker build -f Dockerfile.api .`), not from
# inside vrm_api/ — vrm_api imports victron/*.py and database/*.py as
# top-level packages, exactly as it does when run locally with
# `uvicorn vrm_api.main:app` from the repo root (§1.1: "none of Phase 13's
# sys.path bootstrap is needed, because uvicorn uses the CWD").

FROM python:3.11-slim

# Pango/Cairo/gdk-pixbuf + fonts, per WeasyPrint's own documented Debian
# dependency list (https://doc.courtbouillon.org/weasyprint/stable/
# first_steps.html#debian-ubuntu), plus shared-mime-info (WeasyPrint reads
# it to sniff embedded image types) and real fonts so PDFs don't fall back
# to Debian's default (no) fonts.
#
RUN apt-get update && apt-get install -y --no-install-recommends \
      libpango-1.0-0 \
      libpangocairo-1.0-0 \
      libpangoft2-1.0-0 \
      libcairo2 \
      libgdk-pixbuf-2.0-0 \
      libffi-dev \
      shared-mime-info \
      fonts-dejavu-core \
  && rm -rf /var/lib/apt/lists/*

# victron/templates/weekly_report.html pins `font-family: Arial,
# 'Helvetica Neue', sans-serif` deliberately, to match the exact text
# metrics of reports already sent to real customers. Two metric-compatible
# substitutes were tried first (fonts-liberation's Liberation Sans, then
# fonts-croscore's Arimo) — both close, neither a real glyph match once
# compared against a report rendered locally on macOS (where WeasyPrint
# finds the real thing). ttf-mscorefonts-installer fetches the actual
# Microsoft Arial under Microsoft's own EULA, so this is pixel-identical
# rather than metric-compatible — but it lives in Debian's contrib
# component (not enabled by default) and downloads from an external mirror
# at build time, which is a real, occasional point of failure a font
# choice shouldn't be allowed to take the whole image down over. Falls
# back to fonts-liberation (self-contained, no network fetch, always
# succeeds) if the mscorefonts install fails for any reason — including
# contrib not actually getting enabled here, if a future base-image change
# reshapes sources.list.d/debian.sources enough that the sed below stops
# matching.
RUN sed -i 's/Components: main/Components: main contrib/g' /etc/apt/sources.list.d/debian.sources \
  && apt-get update \
  && echo "ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula select true" | debconf-set-selections \
  && (DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ttf-mscorefonts-installer \
      || apt-get install -y --no-install-recommends fonts-liberation) \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependencies first, source after — so a source-only change doesn't bust
# the (slow, WeasyPrint-adjacent) pip layer on every deploy.
COPY requirements.txt requirements-api.txt ./
RUN pip install --no-cache-dir -r requirements-api.txt

# Only what vrm_api actually imports (victron.*, database.*, config.py,
# utils/*) plus itself — not the Streamlit app, not victron-monitor/web, not
# this repo's plan docs. Keeps the image (and what it could leak if
# compromised) to the pipeline this service exists to run.
#
# calculations.tariff_calculator and calculations.pvgis (ARESEP T-RE tariff
# math and PVGIS irradiance, both shared with the Streamlit proposal tool)
# and proposals.assets.assets:get_logo_b64() (PDF header logo) used to need
# their own COPY lines here — missed once already (PLAN_PHASE14.md §2 Step
# 8), which is exactly the class of miss a wholesale-directory COPY doesn't
# protect against, only defers. Phase 3 of the Dimensionador/VRM Monitor
# split (2026-09-16) forked all three into victron/vrm_shared/, so this
# service no longer imports calculations.* or proposals.* at all — COPY
# victron/ already carries its own copies, and neither calculations/ nor
# proposals/ needs a line here anymore.
COPY victron/ ./victron/
COPY database/ ./database/
COPY utils/ ./utils/
COPY config.py ./config.py
COPY vrm_api/ ./vrm_api/

ENV PYTHONUNBUFFERED=1

# $PORT is Render's convention (it injects the port to bind); default so
# `docker run` without --env PORT still starts something sane locally.
ENV PORT=8000
EXPOSE 8000

CMD ["sh", "-c", "uvicorn vrm_api.main:app --host 0.0.0.0 --port ${PORT}"]
